PORT=5000
NODE_ENV=development

# Required — this app always runs against Turso (libSQL), local dev and every
# deployment. Get these with the Turso CLI:
# `turso db show <db-name> --url` and `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

GROQ_API_KEY=
GEMINI_API_KEY=

# One origin, or a comma-separated list (e.g. local dev + a deployed frontend).
CLIENT_URL=http://localhost:5173

# Contact form email notifications (https://resend.com). Without a verified
# domain, Resend only delivers to the email you signed up with, so sign up
# with the same address you put in CONTACT_INBOX.
RESEND_API_KEY=
CONTACT_INBOX=
MAIL_FROM=NEXUS Contact <onboarding@resend.dev>
