PORT=5000
NODE_ENV=development

# Local SQLite file — used only when TURSO_DATABASE_URL below is not set.
SQLITE_PATH=./data/nexus.sqlite

# Turso (libSQL) — set these to use a Turso database instead of the local
# SQLite file, for local dev and/or any deployment. Get them with the Turso
# CLI: `turso db show <db-name> --url` and `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

GROQ_API_KEY=
GEMINI_API_KEY=

CLIENT_URL=http://localhost:5173
